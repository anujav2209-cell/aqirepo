# AeroCast Kerala Environment Variables Template

# 1. API KEYS (Optional)
# If omitted, the application falls back automatically to keyless Open-Meteo API
# followed by the high-fidelity Simulation Engine for offline local operations.
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_WAQI_API_KEY=your_waqi_token_here

# 2. MODEL CONFIGURATION
# Swaps between 'heuristic' and 'ml' prediction engines on server initialization.
# Can also be toggled dynamically inside the frontend header badge.
ACTIVE_PREDICTION_ENGINE=heuristic

# 3. ML MICROSERVICE ENPOINT (Optional)
# If a trained XGBoost microservice is running, configure its endpoint here.
# MLModelEngine will automatically redirect prediction requests to this endpoint.
ML_SERVICE_ENDPOINT=http://localhost:5000/predict
